{
  "name": "@magna-carta/sign-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "node ../../packages/build-identity/scripts/generate-build-identity.mjs && vp run -w rust-wasm-build-pdf && vp run -w rust-wasm-build-pdf-compose && wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vp test run"
  },
  "dependencies": {
    "@magna-carta/build-identity": "workspace:*",
    "@magna-carta/pdf": "workspace:*",
    "@magna-carta/pdf-compose": "workspace:*",
    "@magna-carta/signing": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@magna-carta/tsconfig": "workspace:*",
    "asn1js": "catalog:",
    "pkijs": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
