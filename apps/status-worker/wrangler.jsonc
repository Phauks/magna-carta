{
  // The isolated, read-only, public status surface. Deliberately its own deployable, separate from
  // the main app worker: it binds ONLY the platform-status KV namespace below — no D1, no R2, no
  // per-firm binding, no service binding into the app. That fate-isolation is the whole point: an
  // app-wide outage (a bad D1 migration, a Durable Object incident, a queue backlog) must never take
  // the status page down with it, since the status page is exactly where operators and customers look
  // during such an outage.
  "name": "magna-carta-status",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  // The public home of this page. The magnacarta.esq zone must exist in the Cloudflare account
  // for deploys to attach the custom domain. workers_dev stays deliberately true alongside it:
  // a status page wants MORE reachable paths during an incident, not fewer, so the workers.dev
  // URL remains a second door.
  "routes": [{ "pattern": "status.magnacarta.esq", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // Same namespace the app worker's cron writes status:derived / status:authored into (see
  // apps/api-worker/wrangler.jsonc) — this worker only ever reads it. This id MUST stay identical to the
  // STATUS_KV id in apps/api-worker/wrangler.jsonc; both bind the one real "Magna_Carta_Status" namespace.
  "kv_namespaces": [{ "binding": "STATUS_KV", "id": "6746720bd1ad4638ad00370197f49788" }],
  // Bundle the page's font (Atkinson Hyperlegible Next, latin variable woff2) into the worker as
  // a binary module, served same-origin from /assets — the page depends on nothing but this
  // worker and KV (no font CDN, no external asset).
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  // An edge cache in front of this worker's entrypoint. Safe HERE and nowhere else in this repo:
  // every response this worker serves is byte-identical for every reader — there is no session, no
  // cookie, no per-firm content, and no `Authorization` header in play — so the cache key (entrypoint
  // + path + query + worker version) fully determines the body. Contrast apps/api-worker, where the firm
  // comes from a session cookie that is NOT part of that key: caching its default entrypoint would
  // serve one firm's /api/v1 reply to the next firm asking for the same path, which is why a fitness
  // guard there rejects this very key. Reasoning: docs/conventions/security.md (response cache-control).
  //
  // The payoff is the incident: a status page takes its traffic spike exactly when its dependencies
  // are least healthy, and on a hit the edge answers without invoking this worker or reading
  // STATUS_KV. That strengthens the fate-isolation this worker exists for rather than weakening it,
  // and it adds no binding.
  //
  // Every response either opts in with an explicit max-age or opts out with no-store (src/index.ts):
  // a response with NO Cache-Control is cached anyway, under heuristic freshness. Deliberately no
  // cross_version_cache: the worker version stays in the cache key, so a deploy starts cold and can
  // never serve a page rendered by superseded code.
  "cache": { "enabled": true },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
