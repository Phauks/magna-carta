{
  // The community board (community.magnacarta.esq): the public, cross-firm request and question
  // board. Its own deployable on its own host, so it can be firewalled or switched off without
  // touching the app, and so its pages never share an origin with a firm's data.
  //
  // It binds the control-plane database, and reads the public status page's store for the board's
  // Known Issues: the board's rows live in the database, and a person's firm and team standing are
  // read from there on every request. No per-firm binding, no bucket, no service binding into the app. The board package cannot reach a firm's database, and
  // this file is where that would be undone, so read apps/community-worker/CLAUDE.md first.
  "name": "magna-carta-community",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "community.magnacarta.esq", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // The interface is the app's own build: the board's screens are routes in apps/web, and the app's
  // reroute hook sends this host's paths to them. Every request reaches the script first, so every
  // answer, the pages included, carries the noindex header the board's design requires from the
  // first byte (the Changelog page, /changelog, alone is listable).
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    // Where the app lives, for the "sign in" link. The board is reached from there.
    "APP_BASE_URL": "https://magnacarta.esq",
  },
  // COMMUNITY_HANDOFF_SECRET is shared with magna-carta's own worker and with nothing else. Without
  // it the board is readable and nobody can sign in. It lives in the account's Secrets Store, bound
  // below as SECRETS_STORE_COMMUNITY_HANDOFF_SECRET, which src/index.ts resolves into the string the
  // board reads; a per-Worker secret of the plain name is the fallback.
  // docs/conventions/operations.md, "Secrets Store", says how a secret moves.
  "secrets_store_secrets": [
    {
      "binding": "SECRETS_STORE_COMMUNITY_HANDOFF_SECRET",
      "store_id": "9ce4ac3eb1774c8c9e46e40edb0efaef",
      "secret_name": "COMMUNITY_HANDOFF_SECRET",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "magna-carta-production-platform-control",
      "database_id": "a0982ab7-97d9-471b-8dd7-19f18aa53f04",
    },
  ],
  // The status page's own store (magna-carta-status binds the same namespace), read and never
  // written: the board shows the unresolved events the public status page already publishes.
  "kv_namespaces": [{ "binding": "STATUS_KV", "id": "6746720bd1ad4638ad00370197f49788" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
