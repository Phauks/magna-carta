{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
