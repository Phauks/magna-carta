{
  "openapi": "3.1.0",
  "info": {
    "title": "Magna Carta API",
    "version": "0.0.0",
    "description": "The Magna Carta legal practice-management API. Every operation is enforced at one chokepoint (tenancy → authn → RBAC → idempotency → rate-limit); errors are RFC 9457 problem documents.",
    "contact": {
      "name": "Magna Carta",
      "url": "https://magnacarta.esq"
    }
  },
  "servers": [
    {
      "url": "https://api.magnacarta.esq/v1",
      "description": "Production API surface"
    },
    {
      "url": "https://app.magnacarta.esq/api",
      "description": "App same-origin surface"
    }
  ],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "time"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "email"
            ]
          },
          "firm": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "user",
          "firm",
          "permissions"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "errorId": {
            "type": "string",
            "pattern": "^error_[A-Za-z0-9_-]{21}$"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          },
          "requestAccess": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errorId"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "detail"
        ]
      },
      "InviteMemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "InviteMemberRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "ProvisionFirmResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "owner": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "name"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "owner"
        ]
      },
      "ProvisionFirmRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "email",
              "name"
            ]
          }
        },
        "required": [
          "name",
          "owner"
        ]
      },
      "InitiateUploadResponse": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "put"
                ]
              },
              "uploadId": {
                "type": "string"
              },
              "fileId": {
                "type": "string"
              },
              "versionId": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "method": {
                "type": "string",
                "enum": [
                  "PUT"
                ]
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "mode",
              "uploadId",
              "fileId",
              "versionId",
              "key",
              "method",
              "url",
              "headers"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "multipart"
                ]
              },
              "uploadId": {
                "type": "string"
              },
              "fileId": {
                "type": "string"
              },
              "versionId": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "uploadId",
              "fileId",
              "versionId",
              "key"
            ]
          }
        ]
      },
      "InitiateUploadRequest": {
        "type": "object",
        "properties": {
          "matterId": {
            "type": "string",
            "pattern": "^matter_[A-Za-z0-9_-]{21}$"
          },
          "folderId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^folder_[A-Za-z0-9_-]{21}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "declaredSize": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "declaredContentType": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "documentTypeId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^documentType_[A-Za-z0-9_-]{21}$"
          },
          "fileId": {
            "type": "string",
            "pattern": "^file_[A-Za-z0-9_-]{21}$"
          }
        },
        "required": [
          "matterId",
          "name",
          "declaredSize",
          "declaredContentType"
        ]
      },
      "SignUploadPartResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "CompleteUploadResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "location"
        ]
      },
      "CompleteUploadRequest": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "partNumber": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "etag": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "partNumber",
                "etag"
              ]
            }
          }
        }
      },
      "AbortUploadResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "aborted"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "description": "Service health — the walking-skeleton control-plane round trip.",
        "operationId": "health.read",
        "tags": [
          "health"
        ],
        "x-mc-operationId": "health.read",
        "x-mc-surface": "public",
        "x-mc-authenticated": false,
        "x-mc-permission": null,
        "x-mc-resource": "firm",
        "x-mc-audited": false,
        "x-mc-idempotency": "optional",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "health"
        ],
        "x-mc-deprecated": false,
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The session user, their firm, and their effective permissions — the SPA's bootstrap call.",
        "operationId": "me.get",
        "tags": [
          "me"
        ],
        "x-mc-operationId": "me.get",
        "x-mc-surface": "app",
        "x-mc-authenticated": true,
        "x-mc-permission": null,
        "x-mc-resource": "firm",
        "x-mc-audited": false,
        "x-mc-idempotency": "optional",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "me"
        ],
        "x-mc-deprecated": false,
        "responses": {
          "200": {
            "description": "The session user, firm, and effective permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The session's firm is not reachable from this deployment, or the session user is a deactivated member of it (absent, never an existence oracle)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members": {
      "post": {
        "description": "Invites a member into the session firm: creates the (unverified, account-less) user, enqueues the per-firm member.provision outbox row, audits the invite — one atomic batch — then sends the activation email (a password-reset link; the reset creates the credential).",
        "operationId": "members.invite",
        "tags": [
          "members"
        ],
        "x-mc-operationId": "members.invite",
        "x-mc-surface": "app",
        "x-mc-authenticated": true,
        "x-mc-permission": "firm:manageMembers",
        "x-mc-resource": "firm",
        "x-mc-audited": true,
        "x-mc-idempotency": "required",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "members"
        ],
        "x-mc-deprecated": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The invited user, pending activation through the emailed reset link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteMemberResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing Idempotency-Key (this operation requires one)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The session member lacks firm:manageMembers",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The session's firm is not reachable from this deployment, or the session member is deactivated (absent, never an existence oracle)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "A request with this Idempotency-Key is still in progress",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The email is already in use, or the Idempotency-Key was reused with a different payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/firms": {
      "post": {
        "description": "Provisions a tenant firm (platform-admin only): firm row, per-firm database created and migrated to head, bucket, owner user with the Owner/Admin role — resumable; re-invoking with the same name no-ops completed steps and returns the existing firm.",
        "operationId": "firms.provision",
        "tags": [
          "firms"
        ],
        "x-mc-operationId": "firms.provision",
        "x-mc-surface": "public",
        "x-mc-authenticated": true,
        "x-mc-permission": "firm:provision",
        "x-mc-resource": "firm",
        "x-mc-audited": true,
        "x-mc-idempotency": "required",
        "x-mc-rateLimit": "auth",
        "x-mc-tags": [
          "firms"
        ],
        "x-mc-deprecated": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionFirmRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The provisioned (or, on an idempotent re-invoke, existing) active firm",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionFirmResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing Idempotency-Key (this operation requires one)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Platform-Admin-Key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "An active firm already holds this name with a different owner, a request with this Idempotency-Key is still in progress, or a concurrent provisioning of the same name completed first (retry to observe it)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The owner email already belongs to another user, or the Idempotency-Key was reused with a different payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "description": "Begins a direct-to-R2 upload: mints the pending file/version/upload-session rows and returns either a single-shot presigned PUT (at or below the firm's mode threshold) or a multipart session (above it). The bytes never transit the Worker.",
        "operationId": "uploads.initiate",
        "tags": [
          "uploads"
        ],
        "x-mc-operationId": "uploads.initiate",
        "x-mc-surface": "app",
        "x-mc-authenticated": true,
        "x-mc-permission": "files:upload",
        "x-mc-resource": "matter",
        "x-mc-audited": true,
        "x-mc-idempotency": "required",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "uploads"
        ],
        "x-mc-deprecated": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The upload was initiated; use the returned URL (PUT) or session (multipart)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing Idempotency-Key (this operation requires one)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The session member lacks files:upload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The firm is unreachable, the member is deactivated, or the target file is unknown",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "A request with this Idempotency-Key is still in progress",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The firm policy refuses this upload, or the Idempotency-Key was reused with a different payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{id}/parts/{partNumber}": {
      "get": {
        "description": "Signs one part of an open multipart upload session, returning a short-TTL presigned PUT URL the client uploads the part to. The session must be open and multipart.",
        "operationId": "uploads.signPart",
        "tags": [
          "uploads"
        ],
        "x-mc-operationId": "uploads.signPart",
        "x-mc-surface": "app",
        "x-mc-authenticated": true,
        "x-mc-permission": "files:upload",
        "x-mc-resource": "matter",
        "x-mc-audited": false,
        "x-mc-idempotency": "optional",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "uploads"
        ],
        "x-mc-deprecated": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^uploadSession_[A-Za-z0-9_-]{21}$"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "required": true,
            "name": "partNumber",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "A presigned PUT URL for the requested part",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignUploadPartResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The session member lacks files:upload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such upload session in this firm",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The session is not open, or is not a multipart session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{id}/complete": {
      "post": {
