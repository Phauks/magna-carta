{
  "openapi": "3.1.0",
  "info": {
    "title": "Magna Carta API",
    "version": "0.0.0",
    "description": "The Magna Carta legal practice-management API. Every operation is enforced at the one ADR-0067 chokepoint (tenancy → authn → RBAC → idempotency → rate-limit); errors are RFC 9457 problem documents.",
    "contact": {
      "name": "Magna Carta",
      "url": "https://magnacarta.esq"
    }
  },
  "servers": [
    {
      "url": "https://api.magnacarta.esq/v1",
      "description": "Production API surface (ADR-0052)"
    },
    {
      "url": "https://app.magnacarta.esq/api",
      "description": "App same-origin surface"
    }
  ],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "time"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "email"
            ]
          },
          "firm": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "user",
          "firm",
          "permissions"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "errorId": {
            "type": "string",
            "pattern": "^err_[A-Za-z0-9_-]{21}$"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          },
          "requestAccess": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "errorId"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "detail"
        ]
      },
      "InviteMemberResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "InviteMemberRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "name"
        ]
      },
      "ProvisionFirmResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "owner": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "name"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "owner"
        ]
      },
      "ProvisionFirmRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "email",
              "name"
            ]
          }
        },
        "required": [
          "name",
          "owner"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "description": "Service health — the walking-skeleton control-plane round trip.",
        "operationId": "health.read",
        "tags": [
          "health"
        ],
        "x-mc-operationId": "health.read",
        "x-mc-surface": "public",
        "x-mc-authenticated": false,
        "x-mc-permission": null,
        "x-mc-resource": "firm",
        "x-mc-audited": false,
        "x-mc-idempotency": "optional",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "health"
        ],
        "x-mc-deprecated": false,
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "description": "The session user, their firm, and their effective permissions — the SPA's bootstrap call.",
        "operationId": "me.get",
        "tags": [
          "me"
        ],
        "x-mc-operationId": "me.get",
        "x-mc-surface": "app",
        "x-mc-authenticated": true,
        "x-mc-permission": null,
        "x-mc-resource": "firm",
        "x-mc-audited": false,
        "x-mc-idempotency": "optional",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "me"
        ],
        "x-mc-deprecated": false,
        "responses": {
          "200": {
            "description": "The session user, firm, and effective permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The session's firm is not reachable from this deployment, or the session user is a deactivated member of it (ADR-0052 — absent, never an existence oracle)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/members": {
      "post": {
        "description": "Invites a member into the session firm: creates the (unverified, account-less) user, enqueues the per-firm member.provision outbox row, audits the invite — one atomic batch — then sends the activation email (a password-reset link; the reset creates the credential).",
        "operationId": "members.invite",
        "tags": [
          "members"
        ],
        "x-mc-operationId": "members.invite",
        "x-mc-surface": "app",
        "x-mc-authenticated": true,
        "x-mc-permission": "firm:manageMembers",
        "x-mc-resource": "firm",
        "x-mc-audited": true,
        "x-mc-idempotency": "required",
        "x-mc-rateLimit": "default",
        "x-mc-tags": [
          "members"
        ],
        "x-mc-deprecated": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The invited user, pending activation through the emailed reset link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteMemberResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing Idempotency-Key (this operation requires one)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The session member lacks firm:manageMembers",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The session's firm is not reachable from this deployment, or the session member is deactivated (ADR-0052 — absent, never an existence oracle)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "A request with this Idempotency-Key is still in progress",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The email is already in use, or the Idempotency-Key was reused with a different payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/firms": {
      "post": {
        "description": "Provisions a tenant firm (platform-admin only): firm row, per-firm database created and migrated to head, bucket, owner user with the Owner/Admin role — resumable; re-invoking with the same name no-ops completed steps and returns the existing firm.",
        "operationId": "firms.provision",
        "tags": [
          "firms"
        ],
        "x-mc-operationId": "firms.provision",
        "x-mc-surface": "public",
        "x-mc-authenticated": true,
        "x-mc-permission": "firm:provision",
        "x-mc-resource": "firm",
        "x-mc-audited": true,
        "x-mc-idempotency": "required",
        "x-mc-rateLimit": "auth",
        "x-mc-tags": [
          "firms"
        ],
        "x-mc-deprecated": false,
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionFirmRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The provisioned (or, on an idempotent re-invoke, existing) active firm",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionFirmResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing Idempotency-Key (this operation requires one)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Platform-Admin-Key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "An active firm already holds this name with a different owner, a request with this Idempotency-Key is still in progress, or a concurrent provisioning of the same name completed first (retry to observe it)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The owner email already belongs to another user, or the Idempotency-Key was reused with a different payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {},
  "tags": [
    {
      "name": "firms"
    },
    {
      "name": "health"
    },
    {
      "name": "me"
    },
    {
      "name": "members"
    }
  ]
}
