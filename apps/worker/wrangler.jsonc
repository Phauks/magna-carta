{
  "name": "magna-carta-app",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  // The SvelteKit SPA (apps/web build output) bound as Workers Static Assets.
  // run_worker_first routes /api/* to the Hono Worker; everything else falls through to assets, with single-page-application not-found handling serving index.html for deep links.
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Control-plane D1. database_id is a local/dry-run placeholder; real provisioning (wrangler d1 create) is the deploy switch.
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "magna-carta-control",
      "database_id": "local-dev-placeholder",
    },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "magna-carta-files" }],
  "queues": { "producers": [{ "binding": "QUEUE", "queue": "magna-carta-jobs" }] },
}
