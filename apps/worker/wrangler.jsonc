{
  // Name matches the Workers Builds dashboard connection (the deployed Worker + its
  // workers.dev URL); a mismatch makes every CI deploy override the name with a warning.
  "name": "magna-carta",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  // Better Auth resolves its workerd build to the AsyncLocalStorage-backed transaction context
  // (node:async_hooks) — without Node.js compatibility every auth route 500s at runtime.
  "compatibility_flags": ["nodejs_compat"],
  // Explicit so deploys stop defaulting them: workers.dev serving stays on (the current
  // public URL until magnacarta.esq attaches); per-version preview URLs stay off
  // (previews are disabled until a staging environment exists — ADR-0075).
  "workers_dev": true,
  "preview_urls": false,
  // The wrangler-side half of the dual `.sql`-as-text bundling contract — full story in
  // src/sql-modules.d.ts (the Vite-side half is the sql-as-text plugin in vitest.config.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // The SvelteKit SPA (apps/web build output) bound as Workers Static Assets.
  // run_worker_first routes /api/* to the Hono Worker; everything else falls through to assets, with single-page-application not-found handling serving index.html for deep links.
  "assets": {
    "directory": "../web/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Real production resources (created 2026-06-09; naming convention in ADR-0075:
  // magna-carta-<environment>-<scope>[-<purpose-or-slug>]). Binding names are the code-facing
  // contract and never change; resource names are environment-scoped and permanent (D1/R2
  // cannot be renamed). Local dev/tests run Miniflare simulations of these bindings.
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "magna-carta-production-platform-control",
      "database_id": "a0982ab7-97d9-471b-8dd7-19f18aa53f04",
    },
    // The firm-database pool (slice 0·4, decided #12): Miniflare cannot create D1 databases
    // at runtime, so local dev and tests pre-declare a fixed pool the dev FirmResourceProvider
    // claims from. A claimed firm's database_identifier IS the binding name, resolved through
    // src/firm-binding-resolver.ts — the same seam deploy-time per-firm bindings use later.
    // The databases are real account resources (created 2026-06-12) because deploys validate
    // every database_id; locally Miniflare just keys its simulated SQLite off the ids. In
    // production the same pool is the pre-REST-adapter starter fleet: until the Cloudflare
    // REST adapter has credentials, provisioning claims these slots (the demo firm takes the
    // first one). Per-firm databases beyond the pool are created and bound through the REST
    // adapter, which requires the documented config-commit + deploy step.
    {
      "binding": "DB_FIRM_POOL_1",
      "database_name": "magna-carta-production-firm-pool-1",
      "database_id": "41cc8ea3-003d-4bbc-a236-7f35d63d03f7",
    },
    {
      "binding": "DB_FIRM_POOL_2",
      "database_name": "magna-carta-production-firm-pool-2",
      "database_id": "eb1b184e-a181-42c7-9895-3ec6d8e8321a",
    },
  ],
  // Runtime secrets this Worker requires — set in the Cloudflare dashboard (Worker → Settings →
  // Variables and Secrets) or with `wrangler secret put`. Declaring them here makes `wrangler deploy`
  // fail loudly with a missing-secret list rather than letting auth routes 500 by design at runtime.
  // CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID are NOT listed: they are optional deploy-time
  // credentials for the REST FirmResourceProvider (the dev pool-claiming adapter runs without them).
  // R2_S3_ACCESS_KEY_ID / R2_S3_SECRET_ACCESS_KEY: the account-scoped R2 S3 API token the upload
  // presigner signs direct-to-R2 URLs with (ADR-0081). Required so a deploy fails loudly rather than
  // serving uploads through the dev presigner. Real presigning ALSO needs CLOUDFLARE_ACCOUNT_ID (the
  // optional REST-adapter secret) for the S3 endpoint host; set all three together.
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "PLATFORM_ADMIN_KEY",
      "R2_S3_ACCESS_KEY_ID",
      "R2_S3_SECRET_ACCESS_KEY",
      "ROOT_KEK",
    ],
  },
  "r2_buckets": [{ "binding": "R2", "bucket_name": "magna-carta-production-platform-files" }],
  // FILES_INGEST carries one R2 event per uploaded object to the ingest consumer (single read:
  // magic-byte gates + streaming SHA-256 + scan port, then commit or quarantine). It is a distinct
  // queue from the platform job queue so upload bursts cannot starve the outbox relay, and so its
  // consumer can be tuned and dead-lettered on its own. The matching `consumers` entry is added with
  // the queue() handler — a declared consumer with no exported handler fails the deploy.
  "queues": {
    "producers": [
      { "binding": "QUEUE", "queue": "magna-carta-production-platform-jobs" },
      { "binding": "FILES_INGEST", "queue": "magna-carta-production-files-ingest" },
      { "binding": "FILES_INGEST_BULK", "queue": "magna-carta-production-files-ingest-bulk" },
    ],
    // The files-ingest consumer (the queue() handler in src/index.ts over the ingest consumer): one
    // R2 object-create event per uploaded object → single-read gates + SHA-256 + scan port → commit
    // or quarantine. A declared consumer with no exported handler fails the deploy, so this lands
    // with the handler. Dead-letters to its own queue after max retries (the 0·2 relay discipline).
    // Both the interactive files-ingest queue and the bulk files-ingest-bulk queue route to the same
    // ingest handler; the lane separation is entirely in queue topology and max_concurrency.
    "consumers": [
      {
        "queue": "magna-carta-production-files-ingest",
        "dead_letter_queue": "magna-carta-production-files-ingest-deadletter",
      },
      {
        "queue": "magna-carta-production-files-ingest-bulk",
        "max_concurrency": 2,
        "dead_letter_queue": "magna-carta-production-files-ingest-bulk-deadletter",
      },
    ],
  },
  // Workers Logs at full sampling (current volumes; the golden-rule-4 structured-JSON event lines
  // the telemetry Workers logger emits land here). Logpush → R2 is a deploy-time runbook step
  // (docs/conventions/operations.md), not code — it is account configuration (slice 0·6, ADR-0074).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The Analytics Engine dataset the telemetry Workers logger mirrors counters to (slice 0·6). The
  // TELEMETRY binding is optional in code (a missing binding degrades to console-only); declaring it
  // here wires the real dataset in production and a local stub under Miniflare.
  "analytics_engine_datasets": [
    { "binding": "TELEMETRY", "dataset": "magna-carta-production-telemetry" },
  ],
  // Cloudflare Email Service send binding (slice 0·6, ADR-0074). The adapter is SELECTED only when
  // EMAIL_FROM is also set — deliberately NOT committed as a var here: it is the activation switch
  // the deploy-time runbook flips once magnacarta.esq is onboarded for Email Sending (DKIM/SPF —
  // docs/conventions/operations.md). Until then the binding is present but unused and production
  // keeps the logging adapter, so no send fails against an un-onboarded domain.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // The scheduled work (src/scheduled.ts): the */5 sweep runs the outbox relay over the control-plane
  // + per-firm lineages, the idempotency TTL purge, and the stale-pending upload sweep; the daily
  // 03:00 UTC pass runs the storage-metering reconciliation (a full R2 LIST per firm — too heavy for
  // every five minutes). src/index.ts routes each Cron expression to its handler.
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *"],
  },
}
