{
  // The Cloudflare Email Worker forward/CC capture entrance. Cloudflare Email Routing delivers a
  // forwarded/CC'd message to the email() handler; this worker resolves the destination to a firm,
  // stages the raw MIME to R2, and enqueues the emails-capture job the main worker's consumer runs.
  // Email Routing rules (the single zone-level catch-all on in.magnacarta.esq, one DMARC) are
  // configured account-side at deploy — see docs/conventions/operations.md — not in this config.
  "name": "magna-carta-email",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  // No public HTTP surface: this worker is reached only by Email Routing.
  "workers_dev": false,
  "preview_urls": false,
  // The control-plane database (capture token → firm id + bucket, via the email_capture_route index) and
  // the shared platform bucket the raw MIME is staged into. Per-firm bucket binding is a deploy-time
  // step, the same seam the ingest consumer reads through.
  "d1_databases": [
    {
      "binding": "DB_CONTROL",
      "database_name": "magna-carta-production-platform-control",
      "database_id": "a0982ab7-97d9-471b-8dd7-19f18aa53f04",
    },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "magna-carta-production-platform-files" }],
  // Producer only: the consumer for this queue lives in the main worker (apps/api-worker), which holds the
  // per-firm database handle the capture job needs.
  "queues": {
    "producers": [
      { "binding": "EMAILS_CAPTURE", "queue": "magna-carta-production-emails-capture" },
    ],
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
