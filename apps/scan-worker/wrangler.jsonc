{
  // The standalone malware-scan worker. Stateless: no D1, R2, or Queues. It owns the
  // ScanContainer Durable Object (a Container-backed DO that runs clamd + the Rust scan service)
  // and is reached only via a service binding from the main app worker — it has no public routes.
  "name": "magna-carta-scan",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  // No public surface: this worker is an internal service reached only via service binding.
  "workers_dev": false,
  "preview_urls": false,
  // The scan Container Durable Object (Container-backed, sqlite-class).
  // The Container runs clamd + the Rust scan service on port 8080 with outbound networking
  // disabled (untrusted bytes never reach the network).
  // max_instances is a ceiling, not a fan-out: one instance runs per Durable Object id, so the
  // capacity is only reachable because src/scan-shard.ts addresses that many distinct DO names.
  // SCAN_SHARD_COUNT there must be changed with this number.
  "containers": [
    {
      "class_name": "ScanContainer",
      "image": "../../containers/scan/Dockerfile",
      "max_instances": 5,
      "instance_type": "standard-1",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "SCAN_CONTAINER", "class_name": "ScanContainer" }],
  },
  // SQLite-backed DO class introduced via migration tag; first migration for this worker.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanContainer"] }],
  // Cron triggers:
  //   0 7 * * * — daily signature-refresh: triggers a wrangler deploy via SCAN_BUILD_DEPLOY_HOOK_URL
  //               so the container image (and therefore ClamAV signatures) is rebuilt daily. A no-op
  //               when SCAN_BUILD_DEPLOY_HOOK_URL is unset (the secret is not required at deploy time).
  //
  //   */20 * * * * — the warm-poke: hits the primary shard's /ready inside the container's 30-minute
  //               sleepAfter, so one standard-1 instance stays resident with clamd's signature DB
  //               loaded. ON since 2026-09-11, the day the first firm uploaded: without it every
  //               scan after a quiet half hour paid a 30-60 s cold start, the engine answered 500
  //               until the DB was loaded, and the member watched "Checking the file" for minutes.
  //               It costs the instance's memory continuously (the figure is kept in
  //               docs/operating-costs.md); with no firms onboarded it was off for that reason.
  //               The interactive ingest lane sends keyless scans to this shard (scan-shard.ts).
  "triggers": {
    "crons": ["0 7 * * *", "*/20 * * * *"],
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
