{
  // The standalone file-recovery worker. It owns the RecoveryEngineContainer Durable Object
  // (a Container-backed DO that runs the pure-Rust recovery engine on port 8080) and is reached
  // only via a service binding from the main app worker — it has no public routes.
  "name": "magna-carta-recovery",
  "main": "./src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  // No public surface: this worker is an internal service reached only via service binding.
  "workers_dev": false,
  "preview_urls": false,
  // The pure-Rust recovery engine Container Durable Object (Container-backed, sqlite-class).
  // The Container runs the recovery engine HTTP service (POST /diagnose|/repair|/carve, GET /ready)
  // on port 8080. Its image builds in Cloudflare Workers Builds from containers/recovery/Dockerfile
  // with the build context set to the repo root, so the Dockerfile can COPY the shared crate deps
  // (crates/engine-host, crates/recovery-core) that the engine host path-depends on.
  "containers": [
    {
      "class_name": "RecoveryEngineContainer",
      "image": "../../containers/recovery/Dockerfile",
      "image_build_context": "../../",
      "max_instances": 5,
      "instance_type": "standard-1",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "RECOVERY_ENGINE", "class_name": "RecoveryEngineContainer" }],
  },
  // SQLite-backed DO class introduced via migration tag; first migration for this worker.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RecoveryEngineContainer"] }],
  // No cron triggers: the Container scales to zero after its sleepAfter (it bills only while a
  // recovery runs). Requests are bursty/on-demand, so a warm-poke cron would pay for an always-on
  // instance to save a cold start that rarely matters.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
