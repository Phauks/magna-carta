node_modules/
.svelte-kit/
apps/web/build/
dist/
.wrangler/
.vite/
coverage/
# Storybook static build (the CI/VRT artifact; built on demand via `storybook-build`)
storybook-static/
# Playwright visual-regression run output (actual/diff images); committed baselines live in
# packages/design-system/visual-regression/baselines/, which is NOT ignored
packages/design-system/visual-regression/test-results/
*.log
.DS_Store
# pre-existing scraping artifacts
.playwright-mcp/
docs/research/trust-rules/_tmp_*
# tooling artifacts
.superpowers/
# Session worktrees: foreign duplicate checkouts that validate themselves in their own session.
# Ignoring them keeps gitignore-respecting walkers (oxlint/oxfmt/tsgolint via vp check) out of
# their mid-build states, which used to fail the main tree's quality gate.
.claude/worktrees/
# Hookify rules: per-machine agent guardrails, not repo policy. The `.local.md` suffix is
# required by the plugin's loader, which globs `.claude/hookify.*.local.md`.
.claude/hookify.*.local.md

# Rust build artifacts (crates workspace + throwaway spikes)
/crates/target/
/spikes/*/target/

# TypeScript project-references build output: composite .d.ts + .tsbuildinfo emitted by
# `tsc -b tsconfig.build.json` (regenerable; the shipped declarations come from the bundler).
.tsbuild/
