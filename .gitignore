node_modules/
.svelte-kit/
apps/web/build/
dist/
.wrangler/
.vite/
coverage/
# Storybook static build (the CI/VRT artifact; built on demand via `storybook-build`)
storybook-static/
# Playwright visual-regression run output (actual/diff images); committed baselines live in
# packages/design-system/visual-regression/baselines/, which is NOT ignored
packages/design-system/visual-regression/test-results/
# Modal geometry sweep output (one screenshot per panel per screen size); nothing there is a baseline
packages/design-system/modal-geometry/test-results/
# apps/web end-to-end run output + the per-run seeded-tenant credentials the setup writes
apps/web/e2e/test-results/
apps/web/e2e/playwright-report/
apps/web/e2e/.seeded/
*.log
.DS_Store
# pre-existing scraping artifacts
.playwright-mcp/
docs/research/trust-rules/_tmp_*
# tooling artifacts
.superpowers/
# Session worktrees: foreign duplicate checkouts that validate themselves in their own session.
# Ignoring them keeps gitignore-respecting walkers (oxlint/oxfmt/tsgolint via vp check) out of
# their mid-build states, which used to fail the main tree's quality gate.
.claude/worktrees/

# Rust build artifacts (crates workspace + throwaway spikes)
/crates/target/
/spikes/*/target/

# Machine-local cargo config written by `vp run bootstrap`: points cargo at one target dir shared by
# every worktree on this machine (an absolute path, so it can never be committed).
/crates/.cargo/

# TypeScript project-references build output: composite .d.ts + .tsbuildinfo emitted by
# `tsc -b tsconfig.build.json` (regenerable; the shipped declarations come from the bundler).
.tsbuild/
# A direct `tsc -b <package>` (rather than the tsconfig.build.json entry point) drops its incremental
# state beside the tsconfig instead of in .tsbuild/. Same regenerable artifact, so ignore it there too.
tsconfig.tsbuildinfo
