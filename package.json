    "lint:matter-timeline-coverage": "node tooling/lint-matter-timeline-coverage/index.mjs",
    "lint:matter-create-control": "node tooling/lint-matter-create-control/index.mjs",
    "lint:test-registration": "node tooling/lint-test-registration.mjs",
    "lint:test-collection": "node tooling/lint-test-collection/index.mjs",
    "lint:affected-scope": "node tooling/affected-lint/scope-fitness.mjs",
