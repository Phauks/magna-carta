{
  "name": "magna-carta",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check && vp run typecheck && node tooling/tsconfig-refs/index.mjs --check && pnpm --filter @magna-carta/api-client run typecheck && pnpm --filter @magna-carta/web check && pnpm --filter @magna-carta/design-system check && vp run rust-check",
    "check:scoped": "node tooling/check-scoped/index.mjs",
    "fix:scoped": "node tooling/check-scoped/fix.mjs",
    "dev": "vp dev",
    "build": "vp build",
    "generate-client": "pnpm --filter @magna-carta/api-client run generate",
    "lint:process-refs": "node tooling/lint-process-references.mjs",
    "lint:custodian-vocabulary": "node tooling/lint-custodian-vocabulary.mjs",
    "lint:conflicts-vocabulary": "node tooling/lint-conflicts-vocabulary/index.mjs",
    "seed-dev-firm": "node tooling/seed-dev-firm.mjs",
    "platform-seal-certificate": "node tooling/platform-seal-certificate/index.mts",
    "lint:licenses": "node tooling/lint-licenses.mjs",
    "lint:status": "node tooling/lint-status.mjs",
    "lint:roadmap": "node tooling/lint-roadmap.mjs",
    "lint:decisions": "node tooling/lint-decisions.mjs",
    "lint:changelog-fragments": "node tooling/lint-changelog-fragments.mjs",
    "lint:test-registration": "node tooling/lint-test-registration.mjs",
    "lint:test-collection": "node tooling/lint-test-collection.mjs",
    "lint:affected-scope": "node tooling/affected-lint/scope-fitness.mjs",
    "postinstall": "node tooling/setup-hooks/index.mjs",
    "test": "node tooling/test-single-flight/index.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.2"
  },
  "packageManager": "pnpm@10.33.2"
}
