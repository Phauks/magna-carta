{
  // Throwaway spike Worker. Deployed by Cloudflare Workers Builds (account-authed; no token needed).
  // The name MUST match the Workers Builds project worker so `wrangler deploy` targets it.
  "name": "mc-collabora-topology-harness",
  "main": "worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "DocumentSession",
      "image": "./Dockerfile",
      "max_instances": 3,
      // Start point only — the measured RSS curve replaces this. standard-2 = 1 vCPU / 6 GiB, the
      // smallest box that gives coolwsd room for several jailed kits; step to standard-3 (2 vCPU /
      // 8 GiB) or standard-4 (4 vCPU / 12 GiB) if a heavy document plus N kits exceeds 6 GiB.
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DOCUMENT_SESSION", "class_name": "DocumentSession" }]
  },
  // Container-backed Durable Objects must be SQLite-backed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentSession"] }],
  // KEEP_ALIVE off = the #147 control run; flip to "on" + redeploy for the mitigation run.
  "vars": { "KEEP_ALIVE": "on", "SLEEP_AFTER": "60s" }
}
