#!/bin/sh
# pre-push — the FAST local gate. The authoritative whole-repo gate (full `pnpm check`, the full
# test suite, the API-contract drift checks, and the container acceptance suites) now runs in GitHub
# Actions on every pull request and push to `main` (.github/workflows/gate.yml) and is required by
# branch protection — so `main` stays green. Since 2026-08-29 `main` is the Workers Builds production
# branch for the app Worker and the SPA, so a merge to it deploys within minutes (docs/conventions/operations.md).
#
# This hook keeps the local loop quick: only the checks the current diff can actually break
# (`pnpm check:scoped`) plus the whole-repo guards that finish in seconds. It is a courtesy tripwire,
# not the gate of record — CI is. To run the full gate locally before a push: `pnpm check && pnpm test`.
# Activated by `vp run setup-hooks` (core.hooksPath -> tooling/git-hooks). SKIP_PREPUSH=1 bypasses.
[ -n "$SKIP_PREPUSH" ] && { echo "pre-push: skipped (SKIP_PREPUSH set) — fix forward"; exit 0; }

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

fail() { echo "pre-push: FAILED — $1 (the full gate runs in GitHub Actions; run \`pnpm check && vp test\` locally)"; exit 1; }
step() { echo "pre-push: $1"; }

# Dependency audit is owned by CI now, not this hook. The gate's `governance` job runs osv-scanner over
# BOTH supply chains (the npm lockfile + every Rust Cargo.lock) against the OSV database, which the local
# `pnpm audit` never covered — and `pnpm audit` depends on npm's retiring audit endpoint anyway. Accepted
# advisories live in osv-scanner.toml. Nothing fast and local replaces it here; the authoritative audit is
# the gate on the pull request.

step "scoped quality gate (fmt + lint + tsc + svelte/rust, for the diff)"
pnpm check:scoped || fail "pnpm check:scoped"

step "governance — no process-artifact references (golden rule 13)"
pnpm run lint:process-refs || fail "lint:process-refs"

step "governance — no raw control characters in source"
pnpm run lint:control-characters || fail "lint:control-characters"

step "governance — dependency license allowlist"
pnpm run lint:licenses || fail "lint:licenses"

# Cheap, and the thing it prevents is not cheap: importing @cloudflare/workers-types where the
# globals already exist loads a SECOND declaration of every Workers interface, and a generic
# comparison across the two copies abandons variance and recurses structurally. One such import put
# a single test file past ten minutes of type-checking.
step "governance — no redundant @cloudflare/workers-types imports"
pnpm run lint:workers-types-import || fail "lint:workers-types-import"

# A plain node script, deliberately NOT a test-runner invocation. These are structural assertions over
# the committed journal/.sql/snapshot set plus one in-memory node:sqlite apply — a runner buys them
# nothing and costs something real: it stands up a worker pool and a transform cache on a machine that
# may already have a suite running in another worktree, and when that contention fails the step, the
# words this hook prints are "migration integrity". That is the scariest false positive available here
# and the one most likely to send someone hunting a lineage break that does not exist; twice it did,
# and the second lesson an agent took from it was to reach for --no-verify. The script takes no lock,
# holds no pool, and finishes in well under a second.
# The same checks run under Vitest via tooling/migration-integrity/migration-integrity.test.mts, from
# the same module — one implementation, so the hook and the suite cannot disagree.
step "migration integrity (journal/chain/rebuild guards)"
node tooling/migration-integrity/index.mts || fail "migration integrity"

echo "pre-push: fast local gates passed — the authoritative whole-repo gate runs in GitHub Actions on main"
exit 0
