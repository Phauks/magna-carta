{
  "name": "@magna-carta/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./control-plane-schema": "./src/control-plane-schema.ts",
    "./data-region": "./src/data-region.ts",
    "./per-firm-schema": "./src/per-firm-schema.ts",
    "./protected-columns": "./src/protected-columns.ts",
    "./migration": "./src/migration.ts",
    "./migration-runner": "./src/migration-runner.ts",
    "./d1-migration-target": "./src/d1-migration-target.ts",
    "./do-sqlite-migration-target": "./src/do-sqlite-migration-target.ts",
    "./do-sqlite-batch-database": "./src/do-sqlite-batch-database.ts",
    "./node-sqlite": "./src/node-sqlite.ts",
    "./drizzle/*": "./drizzle/*"
  },
  "scripts": {
    "test": "vp test run",
    "generate-control-plane-migrations": "drizzle-kit generate --config=drizzle-control-plane.config.ts && node scripts/timestamp-latest-migration.mjs control-plane",
    "generate-per-firm-migrations": "drizzle-kit generate --config=drizzle-per-firm.config.ts && node scripts/timestamp-latest-migration.mjs per-firm"
  },
  "dependencies": {
    "@magna-carta/identifiers": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@magna-carta/access-control": "workspace:*",
    "@magna-carta/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
