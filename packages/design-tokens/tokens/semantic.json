{
  "$description": "Semantic aliases onto primitives — the light/default truth (tokens/modes/* override per mode). Adding a color-bearing semantic token requires adding its @theme inline mapping in tailwind.template.css (until a gate enforces it).",
  "surface": {
    "$description": "Background colors for layered surfaces.",
    "default": { "$type": "color", "$value": "{color.neutral.0}" },
    "raised": { "$type": "color", "$value": "{color.neutral.50}" },
    "sunken": { "$type": "color", "$value": "{color.neutral.100}" },
    "overlay": { "$type": "color", "$value": "{color.neutral.0}" },
    "scrim": { "$type": "color", "$value": "{color.scrim}" }
  },
  "text": {
    "default": { "$type": "color", "$value": "{color.neutral.900}" },
    "muted": { "$type": "color", "$value": "{color.neutral.700}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.600}" },
    "inverse": { "$type": "color", "$value": "{color.neutral.0}" },
    "link": { "$type": "color", "$value": "{color.brand.600}" }
  },
  "action": {
    "$description": "Interactive control colors.",
    "primary": { "$type": "color", "$value": "{color.brand.800}" },
    "primary-hover": { "$type": "color", "$value": "{color.brand.700}" },
    "primary-active": { "$type": "color", "$value": "{color.brand.900}" },
    "primary-foreground": { "$type": "color", "$value": "{color.neutral.0}" },
    "secondary": { "$type": "color", "$value": "{color.neutral.100}" },
    "secondary-hover": { "$type": "color", "$value": "{color.neutral.200}" },
    "secondary-foreground": { "$type": "color", "$value": "{color.neutral.900}" },
    "destructive": { "$type": "color", "$value": "{color.red.500}" },
    "destructive-hover": { "$type": "color", "$value": "{color.red.700}" },
    "destructive-foreground": { "$type": "color", "$value": "{color.neutral.0}" },
    "disabled": { "$type": "color", "$value": "{color.neutral.200}" },
    "disabled-foreground": { "$type": "color", "$value": "{color.neutral.500}" }
  },
  "border": {
    "default": { "$type": "color", "$value": "{color.neutral.200}" },
    "strong": { "$type": "color", "$value": "{color.neutral.500}" },
    "focus": { "$type": "color", "$value": "{color.brand.600}" }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{color.brand.500}" }
  },
  "accent": {
    "$description": "Brand accent — gold by default (the signature thread: active nav, selected, held states, the wordmark). Shared across themes, not theme-varying; a swappable anchor (the role is named, not the value).",
    "default": { "$type": "color", "$value": "{color.accent.700}" },
    "subtle": { "$type": "color", "$value": "{color.accent.100}" },
    "subtle-foreground": { "$type": "color", "$value": "{color.accent.700}" }
  },
  "status": {
    "$description": "Status and feedback colors.",
    "info": { "$type": "color", "$value": "{color.blue.700}" },
    "info-foreground": { "$type": "color", "$value": "{color.neutral.0}" },
    "success": { "$type": "color", "$value": "{color.green.700}" },
    "success-foreground": { "$type": "color", "$value": "{color.neutral.0}" },
    "warning": { "$type": "color", "$value": "{color.amber.500}" },
    "warning-foreground": { "$type": "color", "$value": "{color.neutral.1000}" },
    "danger": { "$type": "color", "$value": "{color.red.500}" },
    "danger-foreground": { "$type": "color", "$value": "{color.neutral.0}" }
  },
  "density": {
    "$description": "Layout density dimensions.",
    "gutter": { "$type": "dimension", "$value": "{space.16}" },
    "stack": { "$type": "dimension", "$value": "{space.12}" },
    "control-height": { "$type": "dimension", "$value": "{control.md}" }
  }
}
