{
  "space": {
    "$description": "Spacing scale on a 4px grid; keys are the pixel value.",
    "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "20": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "32": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "40": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
    "48": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "64": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
    "96": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } }
  },
  "radius": {
    "$description": "Corner radii.",
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
    "full": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
  },
  "control": {
    "$description": "Interactive control heights.",
    "sm": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } }
  }
}
