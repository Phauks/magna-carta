{
  "duration": {
    "$description": "Animation and transition durations.",
    "instant": { "$type": "duration", "$value": { "value": 0, "unit": "ms" } },
    "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
    "normal": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 300, "unit": "ms" } }
  },
  "easing": {
    "$description": "Easing curves.",
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
    "accelerate": { "$type": "cubicBezier", "$value": [0.3, 0, 0.8, 0.15] }
  }
}
