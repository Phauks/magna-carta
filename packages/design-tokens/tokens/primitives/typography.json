{
  "font": {
    "$description": "Font family stacks. System stacks for now; the owner workshop may select branded faces later.",
    "sans": {
      "$type": "fontFamily",
      "$value": ["system-ui", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "Menlo", "monospace"]
    }
  },
  "text": {
    "$description": "Type size scale.",
    "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
    "xl": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "2xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "leading": {
    "$description": "Line-height multipliers.",
    "tight": { "$type": "number", "$value": 1.25 },
    "normal": { "$type": "number", "$value": 1.5 },
    "relaxed": { "$type": "number", "$value": 1.625 }
  },
  "weight": {
    "$description": "Font weights.",
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 }
  },
  "tracking": {
    "$description": "Letter spacing. Pixel values approximate em-based tracking at the base 16px size.",
    "tight": { "$type": "dimension", "$value": { "value": -0.16, "unit": "px" } },
    "normal": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
  }
}
