{
  "font": {
    "$description": "Font family stacks. `sans` defaults to Atkinson Hyperlegible (the legibility-engineered default reading font, design language §4); the user-selectable typeface axis (data-typeface) overrides --mc-font-sans at runtime in a later step. Faces are self-hosted (OFL) by the design-system/app; the stack falls back to the system UI stack until the web fonts load.",
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Atkinson Hyperlegible Next",
        "Atkinson Hyperlegible",
        "system-ui",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "Menlo", "monospace"]
    }
  },
  "text": {
    "$description": "Type size scale, in rem so OS/browser text-size settings scale the whole UI (WCAG 1.4.4 Resize Text; design language §4). Root baseline 16px.",
    "xs": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
    "sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
    "md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
    "lg": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
    "xl": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
    "2xl": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } }
  },
  "leading": {
    "$description": "Line-height multipliers.",
    "tight": { "$type": "number", "$value": 1.25 },
    "normal": { "$type": "number", "$value": 1.5 },
    "relaxed": { "$type": "number", "$value": 1.625 }
  },
  "weight": {
    "$description": "Font weights.",
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 }
  },
  "tracking": {
    "$description": "Letter spacing. Pixel values approximate em-based tracking at the base 16px size.",
    "tight": { "$type": "dimension", "$value": { "value": -0.16, "unit": "px" } },
    "normal": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
  }
}
