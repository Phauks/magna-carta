import { execFileSync } from "node:child_process";
import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

// Generates the two data modules from the checked-in corpus — the single source of truth. Research-
// only provenance (the postal-lookup URL, and what a country calls its own postal code and
// administrative area) is dropped: the words an address form uses are the design system's
// (packages/design-system/src/lib/components/address-fields/address-format.ts), and keeping a second
// copy here would be a second home for the same fact. Run:
// `pnpm --filter @magna-carta/address-formats run build:data`. With `--check` it re-renders and fails
// if a committed file drifted from the corpus (the guard the gate runs).
//
// IT ALSO VALIDATES, AND THAT IS HALF THE POINT. Every pattern must compile as a JavaScript regular
// expression and every example the corpus gives must match its own pattern. A corpus that fails
// either breaks the BUILD, where a person is reading output, rather than the address form, where a
// malformed rule would quietly refuse a postcode that is perfectly correct.
//
// Rendering stays naive (see `toTsLiteral`) — matching the real formatter's output is not this
// script's job. The naive rendering is piped through the repo's actual Oxc formatter (`vp fmt
// --write`), so the committed bytes are what `vp check` accepts by construction rather than a
// hand-reimplementation of its line-wrapping heuristics.

const CORPUS_URL = new URL("../../../docs/research/address-formats/corpus.json", import.meta.url);
const POSTAL_OUT_URL = new URL("../src/data-postal.generated.ts", import.meta.url);
const AREAS_OUT_URL = new URL("../src/data-administrative-areas.generated.ts", import.meta.url);

const HEADER = `// @generated by scripts/build-data.mts from docs/research/address-formats/corpus.json.
// Do NOT edit by hand. Refresh the corpus (\`pnpm --filter @magna-carta/address-formats run
// fetch:corpus\`), then \`pnpm --filter @magna-carta/address-formats run build:data\`.
`;

const IDENTIFIER = /^[A-Za-z_$][A-Za-z0-9_$]*$/;

// Serialize a value as a naive TS literal: arrays and objects are always multiline with 2-space
// indent, string values are double-quoted (`JSON.stringify`), and object keys are unquoted when they
// are valid identifiers. `formatWithOxfmt` below makes the result formatter-clean.
function toTsLiteral(value: unknown, indent: string): string {
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  if (Array.isArray(value)) {
    if (value.length === 0) return "[]";
    const inner = `${indent}  `;
    const items = value.map((one) => `${inner}${toTsLiteral(one, inner)}`).join(",\n");
    return `[\n${items},\n${indent}]`;
  }
  const record = value as Record<string, unknown>;
  const keys = Object.keys(record);
  if (keys.length === 0) return "{}";
  const inner = `${indent}  `;
  const properties = keys
    .map((key) => {
      const rendered = IDENTIFIER.test(key) ? key : JSON.stringify(key);
      return `${inner}${rendered}: ${toTsLiteral(record[key], inner)}`;
    })
    .join(",\n");
  return `{\n${properties},\n${indent}}`;
}

// Run the repo's Oxc formatter over a file in place. Throws rather than exiting so callers keep
// control of cleanup and the exit code — this always runs inside a scratch dir guarded by `finally`.
function formatWithOxfmt(path: string): void {
  try {
    execFileSync("vp", ["fmt", path, "--write"], { stdio: "pipe" });
  } catch (error) {
    const detail = error instanceof Error ? error.message : String(error);
    throw new Error(`formatter command \`vp fmt ${path} --write\` failed: ${detail}`, {
      cause: error,
    });
  }
}

interface RawAdministrativeArea {
  code: string;
  name: string;
}
interface RawCountry {
  name: string;
  postalPattern?: string;
  postalExamples?: string[];
  administrativeAreas?: RawAdministrativeArea[];
}
interface RawCorpus {
  source: string;
  retrievedOn: string;
  countries: Record<string, RawCountry>;
}

/**
 * Fail the build on a corpus that cannot hold. Two rules: a pattern must compile anchored and
 * case-folded exactly as `validatePostalCode` will compile it, and every example must match it. The
 * second is what catches a pattern that compiles but says the wrong thing.
 */
function validateCorpus(corpus: RawCorpus): void {
  const problems: string[] = [];
  for (const [code, country] of Object.entries(corpus.countries)) {
    const { postalPattern } = country;
    if (postalPattern === undefined) continue;
    let anchored: RegExp;
    try {
      anchored = new RegExp(`^(?:${postalPattern})$`, "i");
    } catch (error) {
      problems.push(`${code}: pattern does not compile (${String(error)})`);
      continue;
    }
    for (const example of country.postalExamples ?? []) {
      if (!anchored.test(example)) {
        problems.push(
          `${code}: published example ${JSON.stringify(example)} fails its own pattern`,
        );
      }
    }
  }
  if (problems.length > 0) {
    throw new Error(`the address corpus is not self-consistent:\n  ${problems.join("\n  ")}`);
  }
}

export function renderPostalModule(corpus: RawCorpus): string {
  const entries: Record<string, unknown> = {};
  for (const code of Object.keys(corpus.countries).sort()) {
    const country = corpus.countries[code];
    if (country?.postalPattern === undefined) continue;
    entries[code] = { pattern: country.postalPattern, examples: country.postalExamples ?? [] };
  }
  return (
    `${HEADER}import type { PostalCodeFormat } from "./types.ts";\n\n` +
    `// Keyed by ISO 3166-1 alpha-2. A country absent here publishes no postal-code format, which is\n` +
    `// an answer rather than a gap — see the \`no-pattern\` verdict in types.ts.\n` +
    `export const POSTAL_CODE_FORMATS: Readonly<Record<string, PostalCodeFormat>> = ${toTsLiteral(entries, "")};\n`
  );
}

export function renderAdministrativeAreaModule(corpus: RawCorpus): string {
  const entries: Record<string, unknown> = {};
  for (const code of Object.keys(corpus.countries).sort()) {
    const areas = corpus.countries[code]?.administrativeAreas;
    if (areas === undefined || areas.length === 0) continue;
    entries[code] = areas.map((area) => ({ code: area.code, name: area.name }));
  }
  return (
    `${HEADER}import type { AdministrativeArea } from "./types.ts";\n\n` +
    `// Keyed by ISO 3166-1 alpha-2. A country absent here publishes no administrative-area list, so\n` +
    `// its region field stays free text — which is correct, not a placeholder.\n` +
    `//\n` +
    `// SEPARATE FROM THE POSTAL MODULE ON PURPOSE. This is the larger half by an order of magnitude,\n` +
    `// and a consumer that only validates a postcode should not carry every state, province and\n` +
    `// prefecture to do it. Keeping the two as different modules is what lets this one be imported\n` +
    `// dynamically later without moving a single export.\n` +
    `export const ADMINISTRATIVE_AREAS: Readonly<Record<string, readonly AdministrativeArea[]>> = ${toTsLiteral(entries, "")};\n`
  );
}

/** Render into a scratch file, format it there, and compare with what is committed. */
function formatInScratch(rendered: string, basename: string): string {
  const scratchDir = mkdtempSync(join(tmpdir(), "address-formats-data-"));
  const scratchPath = join(scratchDir, basename);
  try {
    writeFileSync(scratchPath, rendered);
    formatWithOxfmt(scratchPath);
    return readFileSync(scratchPath, "utf8");
  } finally {
    rmSync(scratchDir, { recursive: true, force: true });
  }
}

interface Target {
  readonly url: URL;
  readonly basename: string;
  readonly rendered: string;
}

function main(): void {
  const corpus = JSON.parse(readFileSync(CORPUS_URL, "utf8")) as RawCorpus;
  validateCorpus(corpus);

  const targets: readonly Target[] = [
    {
      url: POSTAL_OUT_URL,
      basename: "data-postal.generated.ts",
      rendered: renderPostalModule(corpus),
    },
    {
      url: AREAS_OUT_URL,
      basename: "data-administrative-areas.generated.ts",
      rendered: renderAdministrativeAreaModule(corpus),
    },
  ];

  if (process.argv.includes("--check")) {
    const drifted: string[] = [];
    for (const target of targets) {
      const formatted = formatInScratch(target.rendered, target.basename);
      if (readFileSync(target.url, "utf8") !== formatted) drifted.push(target.basename);
    }
    if (drifted.length > 0) {
      console.error(`out of sync with corpus.json — run build:data: ${drifted.join(", ")}`);
      process.exit(1);
    }
    console.log("address-formats data is in sync with the corpus.");
    return;
  }

  for (const target of targets) {
    writeFileSync(target.url, formatInScratch(target.rendered, target.basename));
    console.log(`wrote ${target.basename}`);
  }
}

main();
