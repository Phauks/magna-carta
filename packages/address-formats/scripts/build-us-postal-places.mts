/*
 * Projects the GeoNames United States postal-code file into src/data-us-postal-places.generated.ts:
 * which town and state each five-digit ZIP code belongs to, so an address entered ZIP-first can
 * fill in the rest.
 *
 * THE FILE IS AN ARGUMENT, NEVER FETCHED HERE, for the reason fetch-corpus.mts gives: a build that
 * reached a live service could change what a ZIP code fills in under a release nobody made. Refresh
 * by hand, read the diff, commit it:
 *
 *   curl -sSO https://download.geonames.org/export/zip/US.zip && unzip US.zip US.txt
 *   pnpm --filter @magna-carta/address-formats exec tsx scripts/build-us-postal-places.mts US.txt
 *
 * GeoNames publishes the data under Creative Commons Attribution 4.0; the generated module carries
 * the credit, and so does this package's CLAUDE.md.
 *
 * THE ENCODING is one string, one line per town: the state, the town, then its ZIP codes, tab and
 * comma separated and sorted, so the diff of a refresh reads as towns gained and lost. Forty-one
 * thousand codes as an object literal would be several times the size for the same answers.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const source = process.argv[2];
if (source === undefined) {
  console.error("Usage: build-us-postal-places.mts <path to GeoNames US.txt>");
  process.exit(1);
}

const towns = new Map<string, Set<string>>();
for (const line of readFileSync(source, "utf8").split("\n")) {
  const columns = line.split("\t");
  if (columns.length < 5 || columns[0] !== "US") continue;
  const [, zip, town, , state] = columns as [string, string, string, string, string];
  if (!/^\d{5}$/.test(zip) || town.trim() === "" || !/^[A-Z]{2}$/.test(state)) continue;
  const key = `${state}\t${town.trim()}`;
  const codes = towns.get(key) ?? new Set<string>();
  codes.add(zip);
  towns.set(key, codes);
}

const lines = [...towns.entries()]
  .map(([key, codes]) => `${key}\t${[...codes].toSorted().join(",")}`)
  .toSorted();

const target = fileURLToPath(new URL("../src/data-us-postal-places.generated.ts", import.meta.url));
writeFileSync(
  target,
  `// @generated by scripts/build-us-postal-places.mts from the GeoNames United States postal-code file.
// Do NOT edit by hand; the script's header says how to refresh it.
//
// Postal code data from GeoNames (https://www.geonames.org), licensed under Creative Commons
// Attribution 4.0 (https://creativecommons.org/licenses/by/4.0/).
//
// One line per town: state, town, then its ZIP codes, tab and comma separated.
export const US_POSTAL_PLACES = ${JSON.stringify(lines.join("\n"))};
`,
);
console.log(`build-us-postal-places: ${String(lines.length)} towns written to ${target}`);
