import { execFileSync } from "node:child_process";
import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

// Generates src/data.generated.ts from the validated research corpus — the single source of truth.
// It projects each research resource into the shipped model: research-only provenance (confidence,
// sourceUrl, sourceTier) is dropped; the "no program" NA placeholders (PR/AS/MP) fold into a
// jurisdiction's `nationalFallbackOnly` flag with empty resources. Run: `pnpm --filter
// @magna-carta/wellbeing-resources run build:data`. With `--check` it re-renders and fails if the
// committed file drifted from the corpus (a CI-friendly sync guard).
//
// Rendering itself stays naive (see `toTsLiteral` below) — matching the real formatter's output isn't
// this script's job. Instead the naive rendering is piped through the repo's actual Oxc formatter
// (`vp fmt --write`), so the committed bytes are exactly what `vp check` accepts by construction rather
// than a hand-reimplementation of its line-wrapping heuristics.

const PROFILES_URL = new URL(
  "../../../docs/research/wellbeing-resources/profiles.json",
  import.meta.url,
);
const OUT_URL = new URL("../src/data.generated.ts", import.meta.url);

const HEADER = `// @generated by scripts/build-data.mts from docs/research/wellbeing-resources/profiles.json.
// Do NOT edit by hand. Change the research corpus (docs/research/wellbeing-resources/extract/*.json),
// re-run its pipeline (docs/research/wellbeing-resources/pipeline), then
// \`pnpm --filter @magna-carta/wellbeing-resources run build:data\`.
`;

const IDENTIFIER = /^[A-Za-z_$][A-Za-z0-9_$]*$/;

// Serialize a value as a naive TS literal: arrays and objects are always multiline with 2-space
// indent, string values are double-quoted (`JSON.stringify`), and object keys are unquoted when they're
// valid identifiers. This makes no attempt to match the repo's formatter output — `formatWithOxfmt`
// below does that by running the real formatter over the result.
function toTsLiteral(value: unknown, indent: string): string {
  if (typeof value === "string") return JSON.stringify(value);
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  if (Array.isArray(value)) {
    if (value.length === 0) return "[]";
    const inner = `${indent}  `;
    const items = value.map((v) => `${inner}${toTsLiteral(v, inner)}`).join(",\n");
    return `[\n${items},\n${indent}]`;
  }
  const obj = value as Record<string, unknown>;
  const keys = Object.keys(obj);
  if (keys.length === 0) return "{}";
  const inner = `${indent}  `;
  const props = keys
    .map((k) => {
      const key = IDENTIFIER.test(k) ? k : JSON.stringify(k);
      return `${inner}${key}: ${toTsLiteral(obj[k], inner)}`;
    })
    .join(",\n");
  return `{\n${props},\n${indent}}`;
}

// Run the repo's Oxc formatter (via `vp fmt`) over a file in place. Throws (rather than exiting
// directly) so callers stay in control of cleanup and the process exit code — this always runs inside
// a scratch dir guarded by a `finally`.
function formatWithOxfmt(path: string): void {
  try {
    execFileSync("vp", ["fmt", path, "--write"], { stdio: "pipe" });
  } catch (error) {
    const detail = error instanceof Error ? error.message : String(error);
    throw new Error(`formatter command \`vp fmt ${path} --write\` failed: ${detail}`);
  }
}

interface RawPhone {
  number: string;
  label: string;
  availability: string;
  hoursNote?: string;
}
interface RawResource {
  name: string;
  operator: string;
  operatorType: string;
  scope: string;
  url?: string;
  email?: string;
  phones?: RawPhone[];
  services: string[];
  confidential: string;
  cost: string;
  description: string;
  verifiedOn: string;
  confidence?: string;
}
interface RawJurisdiction {
  fips: string;
  code: string;
  name: string;
  resources?: RawResource[];
}
interface RawProfiles {
  national: RawResource[];
  jurisdictions: Record<string, RawJurisdiction>;
}

// Project a research resource to the shipped shape, emitting optional fields only when present so the
// generated file has a clean, stable diff.
function projectResource(r: RawResource): Record<string, unknown> {
  const out: Record<string, unknown> = {
    name: r.name,
    operator: r.operator,
    operatorType: r.operatorType,
    scope: r.scope,
  };
  if (r.url) out.url = r.url;
  if (r.email) out.email = r.email;
  out.phones = (r.phones ?? []).map((p) => {
    const phone: Record<string, unknown> = {
      number: p.number,
      label: p.label,
      availability: p.availability,
    };
    if (p.hoursNote) phone.hoursNote = p.hoursNote;
    return phone;
  });
  out.services = r.services;
  out.confidential = r.confidential;
  out.cost = r.cost;
  out.description = r.description;
  out.verifiedOn = r.verifiedOn;
  return out;
}

function projectJurisdiction(j: RawJurisdiction): Record<string, unknown> {
  const real = (j.resources ?? []).filter((r) => r.confidence !== "NA");
  return {
    fips: j.fips,
    code: j.code,
    name: j.name,
    resources: real.map(projectResource),
    nationalFallbackOnly: real.length === 0,
  };
}

export function renderDataModule(profiles: RawProfiles): string {
  const national = profiles.national.map(projectResource);
  const jurisdictions = Object.values(profiles.jurisdictions)
    .map(projectJurisdiction)
    .sort((a, b) => String(a.fips).localeCompare(String(b.fips)));
  return (
    `${HEADER}import type { JurisdictionEntry, WellbeingResource } from "./types.ts";\n\n` +
    `export const NATIONAL_RESOURCES: readonly WellbeingResource[] = ${toTsLiteral(national, "")};\n\n` +
    `export const JURISDICTIONS: readonly JurisdictionEntry[] = ${toTsLiteral(jurisdictions, "")};\n`
  );
}

// Render into a scratch file, format it there, and report whether the formatted result matches the
// committed OUT_URL — never touching OUT_URL. The scratch dir is always removed via `finally`, even
// when `formatWithOxfmt` throws; the throw itself propagates to the caller once cleanup has run, so
// there is no `process.exit` inside this guarded block.
function checkAgainstCommitted(rendered: string): "in-sync" | "drift" {
  const scratchDir = mkdtempSync(join(tmpdir(), "wellbeing-data-check-"));
  const scratchPath = join(scratchDir, "data.generated.ts");
  try {
    writeFileSync(scratchPath, rendered);
    formatWithOxfmt(scratchPath);
    const formatted = readFileSync(scratchPath, "utf8");
    const current = readFileSync(OUT_URL, "utf8");
    return current === formatted ? "in-sync" : "drift";
  } finally {
    rmSync(scratchDir, { recursive: true, force: true });
  }
}

// Render into a scratch file, format it there, then move the formatter-clean result into OUT_URL —
// so OUT_URL is only ever written with formatted content, never a naive/unformatted intermediate. The
// scratch dir is always removed via `finally`; if `formatWithOxfmt` throws, OUT_URL is left untouched.
function writeGeneratedFile(rendered: string): void {
  const scratchDir = mkdtempSync(join(tmpdir(), "wellbeing-data-write-"));
  const scratchPath = join(scratchDir, "data.generated.ts");
  try {
    writeFileSync(scratchPath, rendered);
    formatWithOxfmt(scratchPath);
    const formatted = readFileSync(scratchPath, "utf8");
    writeFileSync(OUT_URL, formatted);
  } finally {
    rmSync(scratchDir, { recursive: true, force: true });
  }
}

function main(): void {
  const profiles = JSON.parse(readFileSync(PROFILES_URL, "utf8")) as RawProfiles;
  const rendered = renderDataModule(profiles);

  if (process.argv.includes("--check")) {
    let result: "in-sync" | "drift";
    try {
      result = checkAgainstCommitted(rendered);
    } catch (error) {
      console.error(error instanceof Error ? error.message : String(error));
      process.exit(1);
    }
    if (result === "drift") {
      console.error("data.generated.ts is out of sync with profiles.json — run build:data.");
      process.exit(1);
    }
    console.log("data.generated.ts is in sync with profiles.json.");
    return;
  }

  try {
    writeGeneratedFile(rendered);
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error));
    process.exit(1);
  }
  console.log(
    `wrote src/data.generated.ts: ${profiles.national.length} national + ${Object.keys(profiles.jurisdictions).length} jurisdictions`,
  );
}

main();
