{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git worktree list)",
      "Bash(git stash list)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git merge:*)",
      "Bash(git merge-tree:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(git push origin claude/:*)",
      "Bash(git push -u origin docs-sync/:*)",
      "Bash(git push origin docs-sync/:*)",
      "Bash(git push origin remediate-:*)",
      "Bash(git push --force-with-lease -u origin claude/:*)",
      "Bash(git push --force-with-lease origin claude/:*)",
      "Bash(SKIP_PREPUSH=1 git push:*)",
      "Bash(pnpm:*)",
      "Bash(vp:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(python3:*)",
      "Bash(cargo:*)",
      "Bash(rustup:*)",
      "Bash(wasm-pack:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "Artifact",
      "WebFetch",
      "WebSearch",
      "ToolSearch",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "SendMessage",
      "Monitor",
      "EnterWorktree",
      "ExitWorktree",
      "mcp__github",
      "mcp__claude-code-remote"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force origin:*)",
      "Bash(wrangler deploy:*)"
    ]
  }
}
